# Production-образ фронтенда: сборка CRA -> раздача статики через nginx.
# Нужен для работы PWA (service worker активен только в production-сборке).
# Запуск: docker compose -f docker-compose.prod.yml up --build

FROM node:18-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# CRA трактует предупреждения как ошибки в CI-окружении
ENV CI=false
ENV GENERATE_SOURCEMAP=false
RUN npm run build


FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
